{
	"name": "textmode.figlet.js",
	"version": "0.1.0",
	"description": "FIGlet font add-on for textmode.js",
	"type": "module",
	"types": "./dist/types/index.d.ts",
	"main": "./dist/textmode.figlet.umd.js",
	"module": "./dist/textmode.figlet.esm.js",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/textmode.figlet.esm.js",
			"require": "./dist/textmode.figlet.umd.js"
		}
	},
	"sideEffects": [
		"./dist/textmode.figlet.esm.js",
		"./dist/textmode.figlet.umd.js"
	],
	"scripts": {
		"dev": "vite --port 5175 --host",
		"build": "vite build && tsc -p tsconfig.json",
		"check": "npm run format:check && npm run lint && npm run lint:md && npm run typecheck && npm run check:api-docs && npm run test && npm run build",
		"check:api-docs": "node ./scripts/check-public-api-docs.mjs",
		"dev:docs": "typedoc --watch",
		"build:docs": "typedoc",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:contracts": "vitest run --project contracts",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{js,ts,json,md}\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{js,ts,json,md}\"",
		"typecheck": "tsc --noEmit",
		"lint:md": "markdownlint-cli2 --no-globs README.md",
		"lint:md:fix": "markdownlint-cli2 --fix --no-globs README.md",
		"lint": "eslint src --config eslint.config.js",
		"prepare": "husky"
	},
	"peerDependencies": {
		"textmode.js": ">=0.11.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.3.1",
		"@commitlint/config-conventional": "^20.3.1",
		"@rollup/plugin-terser": "^0.4.4",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/github": "^12.0.6",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@types/node": "^24.0.13",
		"@vitest/ui": "^3.1.2",
		"eslint": "^9.39.2",
		"eslint-plugin-jsdoc": "^62.4.1",
		"globals": "^17.1.0",
		"husky": "^9.1.7",
		"jsdom": "^26.1.0",
		"lint-staged": "^16.4.0",
		"markdownlint-cli2": "^0.20.0",
		"prettier": "^3.7.4",
		"semantic-release": "^25.0.3",
		"textmode.js": "^0.11.0",
		"typedoc": "^0.28.13",
		"typedoc-plugin-frontmatter": "^1.3.1",
		"typedoc-plugin-markdown": "^4.9.0",
		"typedoc-vitepress-theme": "^1.1.2",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.53.1",
		"vite": "^6.3.4",
		"vitest": "^3.1.2"
	},
	"keywords": [
		"ascii",
		"figlet",
		"figfont",
		"textmode",
		"creative-coding",
		"graphics"
	],
	"author": "humanbydefinition <hello@textmode.art> (https://code.textmode.art)",
	"license": "MIT",
	"homepage": "https://code.textmode.art",
	"lint-staged": {
		"src/**/*.{ts,js}": "prettier --write"
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/humanbydefinition/textmode.figlet.js.git"
	},
	"bugs": {
		"url": "https://github.com/humanbydefinition/textmode.figlet.js/issues"
	}
}
